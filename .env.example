# Required. Used to generate plain-English weather summaries via the Groq API.
GROQ_API_KEY=your_groq_api_key

# Optional. Port the Express server listens on.
PORT=3000

# Optional. Comma-separated list of origins allowed to call the API cross-origin.
# Same-origin requests (the app calling its own backend) always work regardless of this value.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
